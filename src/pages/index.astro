---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import SearchBar from '@/components/SearchBar.astro';
import TagChip from '@/components/TagChip.astro';
import { getCollection } from 'astro:content';
import { sortPostsByDate, getTagCounts } from '@/lib/utils';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = sortPostsByDate(allPosts);
const tagCounts = getTagCounts(allPosts);
const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);
---

<BaseLayout
  title="Anasayfa"
  description="Kisisel bir bilim ve teknoloji blogu."
>
  <div class="content-wide py-8 md:py-12">
    <!-- Hero -->
    <section class="mb-12 md:mb-16 text-center">
      <!-- Avatar -->
      <div
        class="w-20 h-20 md:w-24 md:h-24 rounded-full mx-auto mb-5 flex items-center justify-center"
        style="background-color: var(--color-surface); border: 2px solid var(--color-border);"
      >
        <span class="font-sans text-2xl md:text-3xl font-bold" style="color: var(--color-text);">A</span>
      </div>
      <h1 class="font-sans text-4xl md:text-5xl font-bold mb-3 md:mb-4 tracking-tight" style="color: var(--color-text);">
        Agnogod
      </h1>
      <p class="text-base md:text-lg max-w-xl mx-auto" style="color: var(--color-text-secondary);">
        Bilim, felsefe ve psikoloji uzerine kendi arguman ve fikirlerimle yazdigim makaleler.
      </p>
    </section>

    <!-- Search -->
    <div class="max-w-xl mx-auto mb-10 md:mb-16">
      <SearchBar />
    </div>

    <!-- Tags cloud -->
    {
      topTags.length > 0 && (
        <section class="mb-10 md:mb-16 text-center">
          <div class="flex flex-wrap justify-center gap-2">
            {topTags.map(([tag, count]) => (
              <a
                href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                class="font-sans text-sm no-underline rounded-full border px-3 py-1 transition-colors"
                style="color: var(--color-text-secondary); border-color: var(--color-border);"
              >
                {tag}
                <span style="color: var(--color-text-muted);" class="ml-1">{count}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Recent posts -->
    <section>
      <h2 class="font-sans text-xl md:text-2xl font-semibold mb-6 md:mb-8" style="color: var(--color-text);">
        Son Yazilar
      </h2>
      {
        posts.length > 0 ? (
          <div class="grid gap-4 md:gap-6 md:grid-cols-2 xl:grid-cols-3">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <p class="text-center py-12" style="color: var(--color-text-muted);">
            Henuz yazi yayinlanmadi.
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
