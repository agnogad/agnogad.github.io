---
export interface Props {
  tag: string;
  size?: 'sm' | 'md';
}

const { tag, size = 'sm' } = Astro.props;
const href = `/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`;
---

<a
  href={href}
  class="font-sans font-medium no-underline rounded-full border inline-block transition-colors"
  class:list={[
    size === 'sm' ? 'text-xs px-2.5 py-0.5' : 'text-sm px-3 py-1',
  ]}
  style={{
    color: 'var(--color-text-secondary)',
    borderColor: 'var(--color-border-light)',
  }}
>
  {tag}
</a>
